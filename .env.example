# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nerd_society?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Upload storage
# Optional: set this to a writable directory on production.
# Example: UPLOAD_DIR="/www/wwwroot/nerdsociety.com.vn/shared/uploads"
UPLOAD_DIR=""

# QR membership check-in
CHECKIN_PROVIDER="qr"
QR_SIGNING_SECRET="replace-with-at-least-32-random-bytes"

# Zalo ZBS Template Message
# Preferred: OAuth credentials. The bootstrap refresh token is used once; rotated
# tokens are encrypted in PostgreSQL. Generate a unique encryption key >= 32 chars.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_TOKEN_ENCRYPTION_KEY=""
# Required only when enabling the delivery webhook.
ZALO_OA_SECRET_KEY=""
# Temporary fallback when OAuth refresh is not configured (expires after ~25h).
ZALO_OA_ACCESS_TOKEN=""
ZALO_ZBS_REQUEST_TIMEOUT_MS="10000"
# Development-mode recipient; must be an App/OA administrator phone.
ZALO_ZBS_TEST_PHONE=""
ZALO_ZBS_TEST_TYPE="CHECK_IN_SUB"

# Approved ZBS template IDs
ZALO_ZBS_TEMPLATE_CHECK_IN_SUB=""
ZALO_ZBS_TEMPLATE_CHECK_IN_WALLET=""
ZALO_ZBS_TEMPLATE_CHECK_OUT_SUB=""
ZALO_ZBS_TEMPLATE_CHECK_OUT_WALLET=""
ZALO_ZBS_TEMPLATE_BLOCK_CHECKIN=""
ZALO_ZBS_TEMPLATE_OVERAGE_WARNING=""
ZALO_ZBS_TEMPLATE_LOW_BALANCE=""
ZALO_ZBS_TEMPLATE_PAYMENT_RECEIVED=""
ZALO_ZBS_TEMPLATE_SUB_EXPIRING=""

# Google Maps API (existing)
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=""

# Payment Gateways
# VNPay
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/callback"

# MoMo
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# ZaloPay
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/create"

# Pusher Cloud (Real-time Chat)
# Đăng ký miễn phí tại pusher.com
PUSHER_APP_ID="your_app_id"
PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="ap1"

# Public Pusher (for client-side)
NEXT_PUBLIC_PUSHER_KEY="your_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
